.load 0x0000
.entry main

: classify   \ ( n -- code )
    DUP 0= IF
        DROP 0
        EXIT
    THEN

    DUP 0< IF
        DROP -1
    ELSE
        DROP 1
    THEN
;

: main
    -5 classify DROP

    10 0 ?DO
        I 5 = IF LEAVE THEN
    LOOP

    2 CASE
        1 OF 11 DROP ENDOF
        2 OF 22 DROP ENDOF
        33 DROP
    ENDCASE

    HALT
;
